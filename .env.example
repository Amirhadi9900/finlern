# Gmail enrollment notifications (Nodemailer OAuth2) — src/pages/api/enrollment-email.ts
# These Google OAuth credentials authorize the info@finlern.fi mailbox to send mail.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=your-google-oauth-redirect-uri
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
NOTIFICATION_EMAIL=info@finlern.fi

# Admin enrollment CSV export (GET /api/admin/enrollments-export)
# Use a random secret at least 32 characters. Never put this key in the browser.
ADMIN_API_KEY=generate-a-32-plus-character-admin-key-here
# Optional comma-separated IP allowlist for the export API
# ADMIN_EXPORT_ALLOWED_IPS=203.0.113.10
